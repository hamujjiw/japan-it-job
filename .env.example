# Opsional. Tanpa key ini, situs tetap jalan penuh:
# deskripsi lowongan ditampilkan apa adanya dari halaman sumber.
# Kalau diisi, deskripsi diringkas otomatis ke Bahasa Indonesia
# (ringkasan peran, tanggung jawab, syarat wajib, nilai tambah, catatan visa).
ANTHROPIC_API_KEY=

# Opsional. Default: claude-sonnet-5
ANTHROPIC_MODEL=

# Opsional. Token untuk endpoint /api/refresh (dipakai Vercel Cron).
CRON_SECRET=
